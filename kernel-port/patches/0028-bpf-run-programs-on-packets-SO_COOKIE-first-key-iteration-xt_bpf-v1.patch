diff --git a/kernel-3.18/include/linux/bpf-cgroup.h b/kernel-3.18/include/linux/bpf-cgroup.h
new file mode 100644
index 000000000..8edbdd04d
--- /dev/null
+++ b/kernel-3.18/include/linux/bpf-cgroup.h
@@ -0,0 +1,74 @@
+#ifndef _BPF_CGROUP_H
+#define _BPF_CGROUP_H
+
+#include <linux/skbuff.h>
+#include <net/sock.h>
+
+/*
+ * Run path for BPF_PROG_TYPE_CGROUP_SKB programs on 3.18.
+ *
+ * Android attaches its accounting programs to the root cgroup only, so one
+ * global program per direction stands in for 4.10's per-cgroup lists.
+ *
+ * The verifier here has no convert_ctx_access, so programs see a real
+ * struct holding the uapi __sk_buff fields they read. The skb sits past the
+ * range programs may read, and only the helpers use it.
+ */
+#define BPF_SKB_CTX_PUBLIC_SIZE	256
+
+struct bpf_skb_ctx {
+	u32 len;
+	u32 pkt_type;
+	u32 mark;
+	u32 queue_mapping;
+	u32 protocol;
+	u32 vlan_present;
+	u32 vlan_tci;
+	u32 vlan_proto;
+	u32 priority;
+	u32 ingress_ifindex;
+	u32 ifindex;
+	u32 tc_index;
+	u32 cb[5];
+	u32 hash;
+	u32 tc_classid;
+	u32 data;
+	u32 data_end;
+	u32 pad[(BPF_SKB_CTX_PUBLIC_SIZE - 84) / 4];
+	struct sk_buff *skb;
+};
+
+#ifdef CONFIG_BPF_SYSCALL
+/* 0: off, 1: run but ignore drops, 2: enforce */
+extern int sysctl_bpf_cgroup_mode;
+extern int sysctl_bpf_cgroup_runs[2];
+extern int sysctl_bpf_cgroup_drops[2];
+
+void bpf_cgroup_global_set(u32 type, struct bpf_prog *prog);
+u32 bpf_skb_prog_run(const struct bpf_prog *prog, struct sk_buff *skb);
+int __bpf_cgroup_run_skb(struct sock *sk, struct sk_buff *skb, u32 type);
+
+static inline int bpf_cgroup_run_ingress(struct sock *sk, struct sk_buff *skb)
+{
+	return sysctl_bpf_cgroup_mode ?
+	       __bpf_cgroup_run_skb(sk, skb, BPF_CGROUP_INET_INGRESS) : 0;
+}
+
+static inline int bpf_cgroup_run_egress(struct sk_buff *skb)
+{
+	return sysctl_bpf_cgroup_mode && skb->sk ?
+	       __bpf_cgroup_run_skb(skb->sk, skb, BPF_CGROUP_INET_EGRESS) : 0;
+}
+#else
+static inline int bpf_cgroup_run_ingress(struct sock *sk, struct sk_buff *skb)
+{
+	return 0;
+}
+
+static inline int bpf_cgroup_run_egress(struct sk_buff *skb)
+{
+	return 0;
+}
+#endif
+
+#endif /* _BPF_CGROUP_H */
