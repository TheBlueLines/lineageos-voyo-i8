+u64 sock_gen_cookie(struct sock *sk)
+{
+	static atomic64_t cookie_gen;
+
+	for (;;) {
+		u64 cookie = atomic64_read(&sk->sk_cookie);
+
+		if (cookie)
+			return cookie;
+		cookie = atomic64_inc_return(&cookie_gen);
+		atomic64_cmpxchg(&sk->sk_cookie, 0, cookie);
+	}
+}
