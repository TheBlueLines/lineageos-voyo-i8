diff --git a/kernel-3.18/kernel/bpf/cgroup_run.c b/kernel-3.18/kernel/bpf/cgroup_run.c
new file mode 100644
index 000000000..08b0504a6
--- /dev/null
+++ b/kernel-3.18/kernel/bpf/cgroup_run.c
@@ -0,0 +1,117 @@
+/*
+ * Run path for cgroup skb programs, see include/linux/bpf-cgroup.h.
+ *
+ * The hooks follow 4.10: ingress in sk_filter(), egress before the output
+ * path fragments the packet, both with skb->data at the network header.
+ */
+
+#include <linux/bpf.h>
+#include <linux/bpf-cgroup.h>
+#include <linux/export.h>
+#include <linux/filter.h>
+#include <linux/if_vlan.h>
+#include <linux/mutex.h>
+#include <linux/netdevice.h>
+#include <linux/rcupdate.h>
+
+int sysctl_bpf_cgroup_mode __read_mostly;
+int sysctl_bpf_cgroup_runs[2];
+int sysctl_bpf_cgroup_drops[2];
+
+static struct bpf_prog __rcu *bpf_cgroup_global[2];
+static DEFINE_MUTEX(bpf_cgroup_global_lock);
+
+/* Holds its own reference: the cgroup slot can be dropped independently. */
+void bpf_cgroup_global_set(u32 type, struct bpf_prog *prog)
+{
+	struct bpf_prog *old;
+
+	if (type > BPF_CGROUP_INET_EGRESS)
+		return;
+	if (prog && prog->aux->prog_type != BPF_PROG_TYPE_CGROUP_SKB)
+		return;
+
+	if (prog)
+		atomic_inc(&prog->aux->refcnt);
+
+	mutex_lock(&bpf_cgroup_global_lock);
+	old = rcu_dereference_protected(bpf_cgroup_global[type],
+			lockdep_is_held(&bpf_cgroup_global_lock));
+	rcu_assign_pointer(bpf_cgroup_global[type], prog);
+	mutex_unlock(&bpf_cgroup_global_lock);
+
+	if (old) {
+		synchronize_rcu();
+		bpf_prog_put(old);
+	}
+}
+
+static void bpf_skb_ctx_fill(struct bpf_skb_ctx *ctx, struct sk_buff *skb)
+{
+	memset(ctx, 0, sizeof(*ctx));
+	ctx->len = skb->len;
+	ctx->pkt_type = skb->pkt_type;
+	ctx->mark = skb->mark;
+	ctx->queue_mapping = skb->queue_mapping;
+	ctx->protocol = skb->protocol;
+	ctx->vlan_present = !!vlan_tx_tag_present(skb);
+	ctx->vlan_tci = vlan_tx_tag_get(skb);
+	ctx->vlan_proto = skb->vlan_proto;
+	ctx->priority = skb->priority;
+	ctx->ingress_ifindex = skb->skb_iif;
+	ctx->ifindex = skb->dev ? skb->dev->ifindex : 0;
+	ctx->hash = skb->hash;
+	ctx->skb = skb;
+}
+
+/* For programs run outside the cgroup path: xt_bpf's pinned mode. */
+u32 bpf_skb_prog_run(const struct bpf_prog *prog, struct sk_buff *skb)
+{
+	struct bpf_skb_ctx ctx;
+
+	bpf_skb_ctx_fill(&ctx, skb);
+	return BPF_PROG_RUN(prog, (void *)&ctx);
+}
+EXPORT_SYMBOL_GPL(bpf_skb_prog_run);
+
+int __bpf_cgroup_run_skb(struct sock *sk, struct sk_buff *skb, u32 type)
+{
+	struct bpf_skb_ctx ctx;
+	struct bpf_prog *prog;
+	struct sock *save_sk;
+	unsigned int offset;
+	u32 verdict;
+
+	if (sk->sk_family != AF_INET && sk->sk_family != AF_INET6)
+		return 0;
+	if (!sk_fullsock(sk))
+		return 0;
+	if (skb->data < skb_network_header(skb))
+		return 0;
+
+	rcu_read_lock();
+	prog = rcu_dereference(bpf_cgroup_global[type]);
+	if (!prog) {
+		rcu_read_unlock();
+		return 0;
+	}
+
+	save_sk = skb->sk;
+	skb->sk = sk;
+	offset = skb->data - skb_network_header(skb);
+	__skb_push(skb, offset);
+
+	bpf_skb_ctx_fill(&ctx, skb);
+	verdict = BPF_PROG_RUN(prog, (void *)&ctx);
+
+	__skb_pull(skb, offset);
+	skb->sk = save_sk;
+	rcu_read_unlock();
+
+	sysctl_bpf_cgroup_runs[type]++;
+	if (verdict & 1)
+		return 0;
+
+	sysctl_bpf_cgroup_drops[type]++;
+	return sysctl_bpf_cgroup_mode >= 2 ? -EPERM : 0;
+}
