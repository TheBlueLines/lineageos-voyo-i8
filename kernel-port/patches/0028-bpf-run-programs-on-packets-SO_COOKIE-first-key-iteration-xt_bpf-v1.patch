+/* Revision 1 follows 4.14. Classic bytecode stays usable through it, and
+ * pinned and fd programs are eBPF, so they need the __sk_buff context. */
+static int bpf_mt_check_v1(const struct xt_mtchk_param *par)
+{
+	struct xt_bpf_info_v1 *info = par->matchinfo;
+	struct sock_fprog_kern program;
+	struct bpf_prog *prog;
+
+	switch (info->mode) {
+	case XT_BPF_MODE_BYTECODE:
+		program.len = info->bpf_program_num_elem;
+		program.filter = info->bpf_program;
+		if (bpf_prog_create(&info->filter, &program)) {
+			pr_info("bpf: check failed: parse error\n");
+			return -EINVAL;
+		}
+		return 0;
+	case XT_BPF_MODE_PATH_PINNED:
+		if (strnlen(info->path, XT_BPF_PATH_MAX) == XT_BPF_PATH_MAX)
+			return -EINVAL;
+		prog = bpf_prog_get_type_path(info->path,
+					      BPF_PROG_TYPE_SOCKET_FILTER);
+		break;
+	case XT_BPF_MODE_FD_ELF:
+		prog = bpf_prog_get(info->fd);
+		if (!IS_ERR(prog) &&
+		    prog->aux->prog_type != BPF_PROG_TYPE_SOCKET_FILTER) {
+			bpf_prog_put(prog);
+			prog = ERR_PTR(-EINVAL);
+		}
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (IS_ERR(prog))
+		return PTR_ERR(prog);
+
+	info->filter = prog;
+	return 0;
+}
+
+static bool bpf_mt_v1(const struct sk_buff *skb, struct xt_action_param *par)
+{
+	const struct xt_bpf_info_v1 *info = par->matchinfo;
+
+	if (info->mode == XT_BPF_MODE_BYTECODE)
+		return BPF_PROG_RUN(info->filter, skb);
+
+	return bpf_skb_prog_run(info->filter, (struct sk_buff *)skb);
+}
+
+static void bpf_mt_destroy_v1(const struct xt_mtdtor_param *par)
+{
+	const struct xt_bpf_info_v1 *info = par->matchinfo;
+
+	if (info->mode == XT_BPF_MODE_BYTECODE)
+		bpf_prog_destroy(info->filter);
+	else
+		bpf_prog_put(info->filter);
+}
