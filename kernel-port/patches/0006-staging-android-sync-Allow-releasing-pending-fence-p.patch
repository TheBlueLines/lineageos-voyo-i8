From daceaa35938f778fbf27353115dd3647f27ac44b Mon Sep 17 00:00:00 2001
From: voyo-port <port@localhost>
Date: Fri, 30 Oct 2026 19:56:32 +0100
Subject: [PATCH 06/22] staging: android: sync: Allow releasing pending fence
 points

---
 kernel-3.18/drivers/staging/android/sync.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/kernel-3.18/drivers/staging/android/sync.c b/kernel-3.18/drivers/staging/android/sync.c
index f4a3fe713..c2e9ac051 100644
--- a/kernel-3.18/drivers/staging/android/sync.c
+++ b/kernel-3.18/drivers/staging/android/sync.c
@@ -439,7 +439,7 @@ static void android_fence_release(struct fence *fence)
 
 	spin_lock_irqsave(fence->lock, flags);
 	list_del(&pt->child_list);
-	if (WARN_ON_ONCE(!list_empty(&pt->active_list)))
+	if (!list_empty(&pt->active_list))
 		list_del(&pt->active_list);
 	spin_unlock_irqrestore(fence->lock, flags);
 
-- 
2.25.1

