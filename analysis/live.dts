	msensor@0 {
		phandle = <0x9c>;
		status = "okay";
		debounce = <0x40 0x00>;
		compatible = "mediatek,msensor";
		interrupt-parent = <0x28>;
		linux,phandle = <0x9c>;
		interrupts = <0x40 0x04>;
	};

	m_mag_pl@0 {
		compatible = "mediatek,m_mag_pl";
	};

	cpus {
		phandle = <0x3f>;
		#address-cells = <0x01>;
		linux,phandle = <0x3f>;
		#size-cells = <0x00>;

		cpu@000 {
			phandle = <0x05>;
			cpu-idle-states = <0x03 0x03 0x03 0x04 0x04 0x04>;
			clock-frequency = <0x52e8f9c0>;
			device_type = "cpu";
			cpu-release-addr = <0x00 0x40000200>;
			enable-method = "psci";
			compatible = "arm,cortex-a53";
			linux,phandle = <0x05>;
			reg = <0x00>;
		};

		cpu@200 {
			phandle = <0x0d>;
			cpu-idle-states = <0x03 0x03 0x03 0x04 0x04 0x04>;
			clock-frequency = <0x88601c00>;
			device_type = "cpu";
			cpu-release-addr = <0x00 0x40000200>;
			enable-method = "psci";
			compatible = "arm,cortex-a72";
			linux,phandle = <0x0d>;
			reg = <0x200>;
		};

		cpu@003 {
			phandle = <0x08>;
			cpu-idle-states = <0x03 0x03 0x03 0x04 0x04 0x04>;
			clock-frequency = <0x52e8f9c0>;
			device_type = "cpu";
			cpu-release-addr = <0x00 0x40000200>;
			enable-method = "psci";
			compatible = "arm,cortex-a53";
			linux,phandle = <0x08>;
			reg = <0x03>;
		};

		cpu@103 {
			phandle = <0x0c>;
			cpu-idle-states = <0x03 0x03 0x03 0x04 0x04 0x04>;
			clock-frequency = <0x743aa380>;
			device_type = "cpu";
			cpu-release-addr = <0x00 0x40000200>;
			enable-method = "psci";
			compatible = "arm,cortex-a53";
			linux,phandle = <0x0c>;
			reg = <0x103>;
		};

		cpu@100 {
			phandle = <0x09>;
			cpu-idle-states = <0x03 0x03 0x03 0x04 0x04 0x04>;
			clock-frequency = <0x743aa380>;
			device_type = "cpu";
			cpu-release-addr = <0x00 0x40000200>;
			enable-method = "psci";
			compatible = "arm,cortex-a53";
			linux,phandle = <0x09>;
			reg = <0x100>;
		};

		cpu@101 {
			phandle = <0x0a>;
			cpu-idle-states = <0x03 0x03 0x03 0x04 0x04 0x04>;
			clock-frequency = <0x743aa380>;
			device_type = "cpu";
			cpu-release-addr = <0x00 0x40000200>;
			enable-method = "psci";
			compatible = "arm,cortex-a53";
			linux,phandle = <0x0a>;
			reg = <0x101>;
		};

		idle-states {
			entry-method = "arm,psci";

			cpu-sleep-0-0 {
				phandle = <0x04>;
				exit-latency-us = <0x258>;
				min-residency-us = <0x4b0>;
				entry-latency-us = <0x258>;
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				linux,phandle = <0x04>;
			};

			cluster-sleep-0 {
				phandle = <0x03>;
				exit-latency-us = <0x3e8>;
				min-residency-us = <0x7d0>;
				entry-latency-us = <0x320>;
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010000>;
				linux,phandle = <0x03>;
			};
		};

		cpu@001 {
			phandle = <0x06>;
			cpu-idle-states = <0x03 0x03 0x03 0x04 0x04 0x04>;
			clock-frequency = <0x52e8f9c0>;
			device_type = "cpu";
			cpu-release-addr = <0x00 0x40000200>;
			enable-method = "psci";
			compatible = "arm,cortex-a53";
			linux,phandle = <0x06>;
			reg = <0x01>;
		};

		cpu@201 {
			phandle = <0x0e>;
			cpu-idle-states = <0x03 0x03 0x03 0x04 0x04 0x04>;
			clock-frequency = <0x88601c00>;
			device_type = "cpu";
			cpu-release-addr = <0x00 0x40000200>;
			enable-method = "psci";
			compatible = "arm,cortex-a72";
			linux,phandle = <0x0e>;
			reg = <0x201>;
		};

		cpu-map {

			cluster2 {

				core0 {
					cpu = <0x0d>;
				};

				core1 {
					cpu = <0x0e>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x09>;
				};

				core3 {
					cpu = <0x0c>;
				};

				core1 {
					cpu = <0x0a>;
				};

				core2 {
					cpu = <0x0b>;
				};
			};

			cluster0 {

				core0 {
					cpu = <0x05>;
				};

				core3 {
					cpu = <0x08>;
				};

				core1 {
					cpu = <0x06>;
				};

				core2 {
					cpu = <0x07>;
				};
			};
		};

		cpu@002 {
			phandle = <0x07>;
			cpu-idle-states = <0x03 0x03 0x03 0x04 0x04 0x04>;
			clock-frequency = <0x52e8f9c0>;
			device_type = "cpu";
