		regulators_supply {
			vemc-supply = <0x14>;
			vcn18-supply = <0x22>;
			vefuse-supply = <0x21>;
			vio18-supply = <0x1a>;
			vsram_proc-supply = <0x1b>;
			vcn33_wifi-supply = <0x25>;
			vrf12-supply = <0x1d>;
			vtcxo28-supply = <0x11>;
			vbif28-supply = <0x20>;
			va18-supply = <0x0f>;
			vcn33_bt-supply = <0x24>;
			compatible = "mediatek,mt_pmic_regulator_supply";
			vmc-supply = <0x16>;
			vsim1-supply = <0x12>;
			vdram-supply = <0x1e>;
