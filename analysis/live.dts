/dts-v1/;

/ {
	#address-cells = <0x02>;
	compatible = "mediatek,MT6797";
	model = "MT6797X";
	interrupt-parent = <0x01>;
	#size-cells = <0x02>;

	m_batch_pl@0 {
		compatible = "mediatek,m_batch_pl";
	};

	m_acc_pl@0 {
		compatible = "mediatek,m_acc_pl";
	};

	trusty {
		#address-cells = <0x02>;
		ranges;
		compatible = "android,trusty-smc-v1";
		#size-cells = <0x02>;

		irq {
			compatible = "android,trusty-irq-v1";
			ppi-interrupt-parent = <0x01>;
		};

		log {
			compatible = "android,trusty-log-v1";
		};

		virtio {
			compatible = "android,trusty-virtio-v1";
		};

		mtee {
			compatible = "mediatek,trusty-mtee-v1";
		};
	};

	mt_pmic_regulator {
		compatible = "mediatek,mt_pmic";

		ldo_regulators {
			compatible = "mediatek,mt_pmic_ldo_regulators";

			ldo_vsim1 {
				phandle = <0x12>;
				status = "okay";
				regulator-enable-ramp-delay = <0x108>;
				regulator-name = "vsim1";
				regulator-default-on = <0x01>;
				regulator-min-microvolt = <0x19f0a0>;
				regulator-max-microvolt = <0x2f4d60>;
				linux,phandle = <0x12>;
			};

			ldo_vgp3 {
				phandle = <0x26>;
				status = "okay";
				regulator-enable-ramp-delay = <0x108>;
				regulator-name = "vgp3";
				regulator-default-on = <0x00>;
				regulator-min-microvolt = <0xf4240>;
				regulator-max-microvolt = <0x1b9e50>;
				linux,phandle = <0x26>;
			};

			ldo_vbif28 {
				phandle = <0x20>;
				regulator-enable-ramp-delay = <0x108>;
				regulator-name = "vbif28";
				regulator-min-microvolt = <0x2ab980>;
				regulator-max-microvolt = <0x2ab980>;
				linux,phandle = <0x20>;
			};

			ldo_vusb33 {
