		buck_regulators {
			compatible = "mediatek,mt_pmic_buck_regulators";

			buck_vs2 {
				phandle = <0x48>;
				regulator-boot-on;
				regulator-enable-ramp-delay = <0xb4>;
				regulator-name = "vs2";
				regulator-always-on;
				regulator-min-microvolt = <0x927c0>;
				regulator-max-microvolt = <0x154456>;
				regulator-ramp-delay = <0x186a>;
				linux,phandle = <0x48>;
			};

			buck_vcore {
				phandle = <0x42>;
				regulator-enable-ramp-delay = <0xb4>;
				regulator-name = "vcore";
				regulator-min-microvolt = <0x927c0>;
				regulator-max-microvolt = <0x154456>;
				regulator-ramp-delay = <0x186a>;
				linux,phandle = <0x42>;
			};

			buck_vmd1 {
				phandle = <0x45>;
				regulator-boot-on;
				regulator-enable-ramp-delay = <0xb4>;
				regulator-name = "vmd1";
