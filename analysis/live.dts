	uncali_mag@0 {
		compatible = "mediatek,uncali_mag";
	};

	hall_eint {
		phandle = <0x3c>;
		compatible = "mediatek,hall-dev-eint";
		linux,phandle = <0x3c>;
	};

	glance_gesture@0 {
		compatible = "mediatek,glance_gesture";
	};

	wake_gesture@0 {
		compatible = "mediatek,wake_gesture";
	};

	scp_sensorHub@0 {
		compatible = "mediatek,sensorHub";
	};

	linearaccel@0 {
		compatible = "mediatek,linearaccel";
	};

	answer_call@0 {
		compatible = "mediatek,answer_call";
	};

	shf {
		compatible = "mediatek,shf";
	};

	activity@0 {
		compatible = "mediatek,activity";
	};

	mtk-msdc.0 {
		#address-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";
		#size-cells = <0x01>;

		msdc0@11230000 {
			phandle = <0x3a>;
			status = "okay";
			mmc-hs200-1_8v;
			clk_src = [01];
			register_setting = <0xc2>;
			bootable;
			max-frequency = <0xbebc200>;
			bus-width = <0x08>;
			clock-names = "msdc0-clock";
			non-removable;
			compatible = "mediatek,mt6797-mmc";
			host_function = [00];
			pinctl = <0xc1>;
			cap-mmc-highspeed;
			linux,phandle = <0x3a>;
			mmc-ddr-1_8v;
			clocks = <0x02 0x21>;
			reg = <0x11230000 0x10000>;
			msdc-sys-suspend;
			interrupts = <0x00 0x4f 0x08>;
		};

		msdc1@11240000 {
			phandle = <0x3b>;
			status = "okay";
			clk_src = [02];
			pinctl_sdr50 = <0xc7>;
			sd-uhs-sdr25;
			register_setting = <0xc9>;
			pinctl_ddr50 = <0xc8>;
			pinctrl-names = "default\0insert_cfg";
			max-frequency = <0xbebc200>;
			bus-width = <0x04>;
			clock-names = "msdc1-clock";
			sd-uhs-sdr104;
			compatible = "mediatek,mt6797-mmc";
			pinctrl-1 = <0xc4>;
			cd_level = [01];
			host_function = [01];
			sd-uhs-sdr50;
			cap-sd-highspeed;
			pinctrl-0 = <0xc3>;
			pinctl = <0xc5>;
			linux,phandle = <0x3b>;
			clocks = <0x02 0x23>;
			reg = <0x11240000 0x10000>;
			msdc-sys-suspend;
			sd-uhs-sdr12;
			pinctl_sdr104 = <0xc6>;
			interrupts = <0x00 0x50 0x08>;
			cd-gpios = <0x52 0x43 0x00>;
		};
	};

	gyroscope@0 {
		phandle = <0x9b>;
		status = "okay";
		pinctrl-names = "pin_default\0pin_cfg";
		debounce = <0x3f 0x00>;
		compatible = "mediatek,gyroscope";
		pinctrl-1 = <0x9f>;
		interrupt-parent = <0x28>;
		pinctrl-0 = <0x9e>;
		linux,phandle = <0x9b>;
		interrupts = <0x3f 0x04>;
	};

	odm {
		phandle = <0x9d>;
		compatible = "simple-bus";
		linux,phandle = <0x9d>;

		lcm_params {
			lcm_params-dbi-io_driving_current;
			lcm_params-dbi-ctrl_io_driving_current;
			lcm_params-dsi-lcm_ext_te_enable;
			lcm_params-dsi-lcm_esd_check_table2;
			lcm_params-dsi-rg_bp;
			lcm_params-dsi-lane_swap0 = <0x04 0x02 0x01 0x00 0x03 0x03>;
			lcm_params-dsi-horizontal_frontporch = <0x3c>;
			lcm_params-dsi-lcm_int_te_monitor;
			lcm_params-dpi-hsync_back_porch;
			lcm_params-dpi-hsync_front_porch;
			lcm_params-dpi-hsync_pulse_width;
			lcm_params-dbi-te_hs_delay_cnt;
			lcm_params-dsi-mode = <0x00>;
			lcm_params-physical_height = <0x84>;
			lcm_params-dsi-fbk_div;
			lcm_params-dsi-ssc_range = <0x03>;
			lcm_params-dpi-mipi_pll_clk_fbk_div;
			lcm_params-dsi-lane_swap1 = <0x02 0x04 0x03 0x01 0x00 0x04>;
			lcm_params-dsi-cont_clock;
			lcm_params-dpi-bg_height;
			lcm_params-dsi-horizontal_frontporch_word_count;
			lcm_params-dsi-horizontal_backporch = <0x1e>;
			lcm_params-dsi-horizontal_sync_active_word_count;
			lcm_params-dbi-cpu_write_bits;
			lcm_params-dsi-switch_mode;
			lcm_params-dsi-dsi_clock;
			lcm_params-dsi-lane_swap_en = <0x01>;
