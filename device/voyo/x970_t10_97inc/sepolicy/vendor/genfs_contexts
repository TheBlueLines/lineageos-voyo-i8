# MediaTek GPU DVFS interface (GED), used by the composer, gralloc and
# surfaceflinger on every frame.
genfscon proc /ged u:object_r:proc_ged:s0
genfscon proc /bootprof u:object_r:proc_bootprof:s0
genfscon proc /ppm u:object_r:proc_ppm:s0
genfscon proc /gpufreq u:object_r:proc_gpufreq:s0
genfscon proc /last_kmsg u:object_r:proc_mtk_last_kmsg:s0
# Backlight and indicator LEDs (leds-mt65xx).
genfscon sysfs /devices/platform/leds-mt65xx/leds u:object_r:sysfs_leds:s0
# eMMC queue attributes; init tunes discard_max_bytes for userdata.
genfscon sysfs /devices/mtk-msdc.0/11230000.msdc0/mmc_host/mmc0/mmc0:0001/block u:object_r:sysfs_devices_block:s0
