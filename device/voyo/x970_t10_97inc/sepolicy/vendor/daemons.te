# Daemon needs not covered by the stock Android 8 policy.

# Health HAL: the battery is /sys/devices/platform/battery/power_supply.
r_dir_file(hal_health_default, sysfs_power_supply)

# Thermal HAL reads the MTK thermal zones.
r_dir_file(hal_thermal_default, proc_mtktz)

# Stock audio module: headset switch state and the system effects config.
allow hal_audio_default sysfs_switch:dir search;
allow hal_audio_default system_file:file r_file_perms;

# Stock A2DP module: the audio control and data sockets of the Bluetooth stack.
allow hal_audio_default bluetooth:unix_stream_socket connectto;

# gralloc maps ashmem for buffer metadata. The composer loads gralloc in-process
# for its overlay scratch buffers; without this every rotated camera preview
# frame loses its buffer and the layer flickers.
allow { hal_graphics_allocator_default hal_graphics_composer_default } ashmem_device:chr_file r_file_perms;

# Once a buffer exists the composer's blit path reaches libdpframework's PQ
# setup, which maps HIDL shared memory and aborts the process if that fails.
allow hal_graphics_composer_default hidl_memory_hwservice:hwservice_manager find;
allow hal_graphics_composer_default hal_allocator_server:fd use;

# libnvram parses /data/nvram/fstab.mt6797 (copied there by init).
allow { mtk_hal_bluetooth mtk_stock_domain } nvram_data_file:dir search;
allow { mtk_hal_bluetooth mtk_stock_domain } nvram_data_file:file r_file_perms;

# Power HAL probes /data/tmp/smart (MTK smart-boost flag; absent here).
dontaudit mtk_hal_power system_data_file:file r_file_perms;
# stp_dump3 tries to save connsys dumps on the sdcard.
dontaudit stp_dump3 fuse:dir rw_dir_perms;
dontaudit stp_dump3 fuse:file create_file_perms;

allow sysenv_daemon proc_lk_env:file ioctl;
allow thermal_manager thermalloadalgod:unix_stream_socket connectto;

# Service sockets for wfca and the C2K modem daemons.
allow init { wfca_socket msap_c2k_socket mtk_ril_socket }:sock_file { create setattr getattr unlink };
allow { mtk_stock_domain rild } { wfca_socket msap_c2k_socket mtk_ril_socket }:sock_file write;
# sysenv_daemon reads/writes LK environment through /proc/lk_env ioctls ('e').
allowxperm sysenv_daemon proc_lk_env:file ioctl { 0x6500-0x65ff };

# Power HAL drives the PPM core/frequency limits.
allow mtk_hal_power proc_ppm:dir search;
allow mtk_hal_power proc_ppm:file rw_file_perms;

# Platform processes probe unset ro.odm.*/vendor props; nothing to read.
dontaudit { audioserver surfaceflinger system_server } vendor_default_prop:file r_file_perms;
# Kernel threads following the sdcard symlinks (connsys dump path).
dontaudit kernel fuse:dir search;
dontaudit kernel { mnt_user_file storage_file }:lnk_file read;
dontaudit kernel self:capability { dac_override dac_read_search };

# ccci_mdinit polls init.svc.* of the modem daemons (a private platform type
# vendor policy cannot name); denied, it just retries, ~1200 audits per boot.
dontaudit ccci_mdinit property_type:file { read open getattr map };
dontaudit mtk_hal_power system_data_file:file append;

# eMMC block attributes (relabelled in genfs_contexts).
r_dir_file(sysenv_daemon, sysfs_devices_block)
allow init sysfs_devices_block:file w_file_perms;

# camerahalserver: its prebuilt libcutils opens /dev/ashmem directly (FMQ for the
# HIDL session), seninf reads the efuse through /dev/devmap, and m4u and the JPEG
# encoder are ioctls on /proc entries, which Android 13 filters by command.
allow mtk_hal_camera ashmem_device:chr_file r_file_perms;
allow mtk_hal_camera devmap_device:chr_file r_file_perms;
allowxperm mtk_hal_camera proc:file ioctl { 0x6700-0x67ff 0x7800-0x78ff };

# rilproxy (rild) sits between the framework and mtkrild. These are what it
# asked for on its first run; mtkrild reads the eMMC name and LK environment.
allow rild mtkrild:unix_stream_socket connectto;
vndbinder_use(rild)
allow rild hal_audio_hwservice:hwservice_manager find;
r_dir_file(mtkrild, sysfs_devices_block)
allowxperm mtkrild proc_lk_env:file ioctl { 0x6500-0x65ff };
