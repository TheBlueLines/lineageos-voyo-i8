# Mount points in the root of /system for the MediaTek NV partitions.
/nvdata     u:object_r:rootfs:s0
/nvcfg      u:object_r:rootfs:s0
/protect_f  u:object_r:rootfs:s0
/protect_s  u:object_r:rootfs:s0

# GPU and display nodes. Unlabelled (device) they were denied on every
# ioctl, and permissive mode on 3.18 does not cache ioctl grants, so each
# frame produced audit records (~230/s were dropped).
/dev/mali0          u:object_r:gpu_device:s0
/dev/mtk_disp_mgr   u:object_r:graphics_device:s0

# The Android 8 vndservicemanager, kept for the stock vendor binder clients.
/vendor/bin/vndservicemanager_o  u:object_r:vndservicemanager_exec:s0

