# Display
ro.sf.lcd_density=320
ro.opengles.version=196610
ro.hardware.egl=mali

# HALs
ro.hardware.gralloc=mt6797
ro.hardware.hwcomposer=mt6797
ro.hardware.camera=mt6797
ro.hardware.sensors=mt6797

# USB: the 3.18 FunctionFS has no AIO.
sys.usb.ffs.aio_compat=1

# Kernel 3.18 is in no Android 13 compatibility matrix.
ro.vendor.vintf.legacy_kernel=true

# The stock audio HAL uses the Android 8 audio.h stream layout.
ro.vendor.audio.legacy_oreo_abi=true

# Camera: Android 13 dropped device HAL 1, so make the MTK provider offer HAL3.
persist.mtkcam.aosp_hal_legacy=0
persist.mtkcam.aosp_hal_version=3
