From ae8c3b8935a85490acde915bfe642d154f3a7494 Mon Sep 17 00:00:00 2001
From: TWRP Builder <builder@localhost>
Date: Tue, 3 Nov 2026 08:45:00 +0100
Subject: [PATCH] audio: support a legacy HAL built with the Oreo audio.h

Change-Id: I7392930260341624ba4313c83d13ce08c69368d2
---
 audio/core/all-versions/default/Device.cpp    |  6 ++--
 .../all-versions/default/PrimaryDevice.cpp    |  8 +++--
 audio/core/all-versions/default/StreamIn.cpp  | 18 +++++------
 audio/core/all-versions/default/StreamOut.cpp | 32 +++++++++----------
 .../default/include/core/default/Device.h     |  6 +++-
 5 files changed, 38 insertions(+), 32 deletions(-)

diff --git a/audio/core/all-versions/default/Device.cpp b/audio/core/all-versions/default/Device.cpp
index cbcdf22..7801615 100644
--- a/audio/core/all-versions/default/Device.cpp
+++ b/audio/core/all-versions/default/Device.cpp
@@ -47,8 +47,8 @@ namespace util {
 using namespace ::android::hardware::audio::CORE_TYPES_CPP_VERSION::implementation::util;
 }
 
-Device::Device(audio_hw_device_t* device, bool hasNougatAbi)
-    : mIsClosed(false), mDevice(device), mHasNougatAbi(hasNougatAbi) {}
+Device::Device(audio_hw_device_t* device, bool hasNougatAbi, bool hasOreoAbi)
+    : mIsClosed(false), mDevice(device), mHasNougatAbi(hasNougatAbi), mHasOreoAbi(hasOreoAbi) {}
 
 Device::~Device() {
     (void)doClose();
@@ -551,7 +551,7 @@ Return<void> Device::getMicrophones(getMicrophones_cb _hidl_cb) {
 
     hidl_vec<MicrophoneInfo> microphones;
     // In a Nougat HAL this field is dump(), see hasNougatAbi().
-    if (!mHasNougatAbi && mDevice->get_microphones != NULL &&
+    if (!hasLegacyStreamAbi() && mDevice->get_microphones != NULL &&
         mDevice->get_microphones(mDevice, &mic_array[0], &actual_mics) == 0) {
         microphones.resize(actual_mics);
         for (size_t i = 0; i < actual_mics; ++i) {
diff --git a/audio/core/all-versions/default/PrimaryDevice.cpp b/audio/core/all-versions/default/PrimaryDevice.cpp
index a807c54..5dc97c9 100644
--- a/audio/core/all-versions/default/PrimaryDevice.cpp
+++ b/audio/core/all-versions/default/PrimaryDevice.cpp
@@ -35,10 +35,12 @@ namespace util {
 using namespace ::android::hardware::audio::CORE_TYPES_CPP_VERSION::implementation::util;
 }
 
-// ro.vendor.audio.legacy_nougat_abi marks the primary legacy HAL as a Nougat build, see
-// Device::hasNougatAbi(). The other modules loaded by this service are not affected.
+// ro.vendor.audio.legacy_nougat_abi and ro.vendor.audio.legacy_oreo_abi mark the primary
+// legacy HAL as a Nougat or Oreo build, see Device::hasNougatAbi() and
+// Device::hasLegacyStreamAbi(). The other modules loaded by this service are not affected.
 PrimaryDevice::PrimaryDevice(audio_hw_device_t* device)
-    : mDevice(new Device(device, property_get_bool("ro.vendor.audio.legacy_nougat_abi", false))) {
+    : mDevice(new Device(device, property_get_bool("ro.vendor.audio.legacy_nougat_abi", false),
+                         property_get_bool("ro.vendor.audio.legacy_oreo_abi", false))) {
     ALOGI_IF(mDevice->hasNougatAbi(),
              "Primary HAL has the Nougat audio.h layout, post-Nougat methods are not supported");
 }
diff --git a/audio/core/all-versions/default/StreamIn.cpp b/audio/core/all-versions/default/StreamIn.cpp
index 09c9760..0ada725 100644
--- a/audio/core/all-versions/default/StreamIn.cpp
+++ b/audio/core/all-versions/default/StreamIn.cpp
@@ -334,17 +334,17 @@ Return<Result> StreamIn::setParameters(const hidl_vec<ParameterValue>& context,
 // A Nougat audio_stream_in ends at get_capture_position(): for such a HAL
 // (Device::hasNougatAbi()) the MMAP fields and all fields added after them are not read.
 Return<Result> StreamIn::start() {
-    if (mDevice->hasNougatAbi()) return Result::NOT_SUPPORTED;
+    if (mDevice->hasLegacyStreamAbi()) return Result::NOT_SUPPORTED;
     return mStreamMmap->start();
 }
 
 Return<Result> StreamIn::stop() {
-    if (mDevice->hasNougatAbi()) return Result::NOT_SUPPORTED;
+    if (mDevice->hasLegacyStreamAbi()) return Result::NOT_SUPPORTED;
     return mStreamMmap->stop();
 }
 
 Return<void> StreamIn::createMmapBuffer(int32_t minSizeFrames, createMmapBuffer_cb _hidl_cb) {
-    if (mDevice->hasNougatAbi()) {
+    if (mDevice->hasLegacyStreamAbi()) {
         _hidl_cb(Result::NOT_SUPPORTED, MmapBufferInfo());
         return Void();
     }
@@ -353,7 +353,7 @@ Return<void> StreamIn::createMmapBuffer(int32_t minSizeFrames, createMmapBuffer_
 }
 
 Return<void> StreamIn::getMmapPosition(getMmapPosition_cb _hidl_cb) {
-    if (mDevice->hasNougatAbi()) {
+    if (mDevice->hasLegacyStreamAbi()) {
         _hidl_cb(Result::NOT_SUPPORTED, MmapPosition());
         return Void();
     }
@@ -567,7 +567,7 @@ Result StreamIn::doUpdateSinkMetadataV7(const SinkMetadata& sinkMetadata) {
 
 #if MAJOR_VERSION <= 6
 Return<void> StreamIn::updateSinkMetadata(const SinkMetadata& sinkMetadata) {
-    if (mDevice->hasNougatAbi() || mStream->update_sink_metadata == nullptr) {
+    if (mDevice->hasLegacyStreamAbi() || mStream->update_sink_metadata == nullptr) {
         return Void();  // not supported by the HAL
     }
     (void)doUpdateSinkMetadata(sinkMetadata);
@@ -576,7 +576,7 @@ Return<void> StreamIn::updateSinkMetadata(const SinkMetadata& sinkMetadata) {
 #elif MAJOR_VERSION >= 7
 Return<Result> StreamIn::updateSinkMetadata(const SinkMetadata& sinkMetadata) {
     if (mDevice->version() < AUDIO_DEVICE_API_VERSION_3_2) {
-        if (mDevice->hasNougatAbi() || mStream->update_sink_metadata == nullptr) {
+        if (mDevice->hasLegacyStreamAbi() || mStream->update_sink_metadata == nullptr) {
             return Result::NOT_SUPPORTED;
         }
         return doUpdateSinkMetadata(sinkMetadata);
@@ -595,7 +595,7 @@ Return<void> StreamIn::getActiveMicrophones(getActiveMicrophones_cb _hidl_cb) {
     audio_microphone_characteristic_t mic_array[AUDIO_MICROPHONE_MAX_COUNT];
 
     hidl_vec<MicrophoneInfo> microphones;
-    if (!mDevice->hasNougatAbi() && mStream->get_active_microphones != NULL &&
+    if (!mDevice->hasLegacyStreamAbi() && mStream->get_active_microphones != NULL &&
         mStream->get_active_microphones(mStream, &mic_array[0], &actual_mics) == 0) {
         microphones.resize(actual_mics);
         for (size_t i = 0; i < actual_mics; ++i) {
@@ -611,7 +611,7 @@ Return<void> StreamIn::getActiveMicrophones(getActiveMicrophones_cb _hidl_cb) {
 
 #if MAJOR_VERSION >= 5
 Return<Result> StreamIn::setMicrophoneDirection(MicrophoneDirection direction) {
-    if (mDevice->hasNougatAbi() || mStream->set_microphone_direction == nullptr) {
+    if (mDevice->hasLegacyStreamAbi() || mStream->set_microphone_direction == nullptr) {
         return Result::NOT_SUPPORTED;
     }
     if (!common::utils::isValidHidlEnum(direction)) {
@@ -625,7 +625,7 @@ Return<Result> StreamIn::setMicrophoneDirection(MicrophoneDirection direction) {
 }
 
 Return<Result> StreamIn::setMicrophoneFieldDimension(float zoom) {
-    if (mDevice->hasNougatAbi() || mStream->set_microphone_field_dimension == nullptr) {
+    if (mDevice->hasLegacyStreamAbi() || mStream->set_microphone_field_dimension == nullptr) {
         return Result::NOT_SUPPORTED;
     }
     if (std::isnan(zoom) || zoom < -1 || zoom > 1) {
