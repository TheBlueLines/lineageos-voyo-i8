+namespace {
+
+// An Oreo audio_port_config has no flags field: ext directly follows gain.
+constexpr size_t kOreoPortConfigExtOffset = offsetof(audio_port_config, flags);
+constexpr size_t kOreoPortConfigSize = kOreoPortConfigExtOffset + sizeof(audio_port_config::ext);
+
+// Rewrites an array of audio_port_config in place in the Oreo layout.
+void packOreoPortConfigs(audio_port_config* configs, size_t count) {
+    uint8_t* out = reinterpret_cast<uint8_t*>(configs);
+    for (size_t i = 0; i < count; ++i, out += kOreoPortConfigSize) {
+        memmove(out, &configs[i], kOreoPortConfigExtOffset);
+        memmove(out + kOreoPortConfigExtOffset, &configs[i].ext, sizeof(configs[i].ext));
+    }
+}
+
+}  // namespace
+
+Device::Device(audio_hw_device_t* device, bool hasNougatAbi, bool hasOreoAbi)
+    : mIsClosed(false), mDevice(device), mHasNougatAbi(hasNougatAbi), mHasOreoAbi(hasOreoAbi) {}
 
