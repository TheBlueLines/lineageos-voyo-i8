diff --git a/audio/core/all-versions/default/include/core/default/Device.h b/audio/core/all-versions/default/include/core/default/Device.h
index ea1ef8c..2808de8 100644
--- a/audio/core/all-versions/default/include/core/default/Device.h
+++ b/audio/core/all-versions/default/include/core/default/Device.h
@@ -53,7 +53,8 @@ using AudioInputFlags = CoreUtils::AudioInputFlags;
 using AudioOutputFlags = CoreUtils::AudioOutputFlags;
 
 struct Device : public IDevice, public ParametersUtil {
-    explicit Device(audio_hw_device_t* device, bool hasNougatAbi = false);
+    explicit Device(audio_hw_device_t* device, bool hasNougatAbi = false,
+                    bool hasOreoAbi = false);
 
     // Methods from ::android::hardware::audio::CPP_VERSION::IDevice follow.
     Return<Result> initCheck() override;
@@ -186,11 +187,14 @@ struct Device : public IDevice, public ParametersUtil {
     // Audio patches are reported as unsupported, so AudioFlinger routes the streams with
     // set_parameters("routing=..."), as for a pre-3.0 HAL.
     bool hasNougatAbi() const { return mHasNougatAbi; }
+    // Streams of a Nougat or Oreo HAL end before update_*_metadata.
+    bool hasLegacyStreamAbi() const { return mHasNougatAbi || mHasOreoAbi; }
 
   private:
     bool mIsClosed;
     audio_hw_device_t* mDevice;
     const bool mHasNougatAbi;
+    const bool mHasOreoAbi;
     int mOpenedStreamsCount = 0;
 
     virtual ~Device();
